{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inat-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InatMCP"] },
    { "tag": "v2", "deleted_classes": ["InatMCP"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inat-seen-obs",
      "database_id": "ddaa00a3-5f68-48ce-ba3b-36551a476566"
    }
  ]
}
